      "withdrawal",
      "stalemate"
    ],
    "same_tick_rule": "one_terminal_per_tick_by_priority",
    "terminal_idempotent": true,
    "truth_report_split": true,
    "no_contribution_exception": true,
    "zero_completed_at_explicit_hard_limit_is": "defeat",
    "timeout_never_yields_victory": true
  },
  "contribution_rules": {
    "objective_completion": "authority evaluates real permanent state; separate from player credit",
    "objective_credit": "player direct or authorized ally request execution; ally autonomous is ally credit",
    "command_evaluation_order": [
      "主导",
      "有效协同",
      "有限参与",
      "未参与"
    ],
    "command_evaluation_unique": true,
    "ally_autonomous": "truth victory remains victory; evaluation 未参与; no stalemate exception",
    "player_no_action": "M0 no auto terminal at window; mission ongoing until objective/loss/withdrawal conditions",
    "no_identity_immunity": true,
    "delivery_vs_request_vs_execution": {
      "delivered": "message arrived",
      "accepted": "ally agreed",
      "executing": "ally acting",
      "objective_completed": "authority real state",
      "note": "不可混用"
    }
  },
